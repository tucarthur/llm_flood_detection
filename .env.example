ANTHROPIC_API_KEY=  # only needed for agent/estimate_tokens.py's Claude-pricing estimate

# Classifier agent config -- points at a vLLM server (see docker-compose.yml),
# not Anthropic's API.
VLLM_BASE_URL=http://localhost:8000/v1  # or http://<gpu-host>:8000/v1 if vLLM runs elsewhere
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLLM_API_KEY=EMPTY  # vLLM ignores this unless an auth proxy requires it

# Gemini API (used with `agent.run --provider gemini`). Gemma models get the usable
# free tier (~30 req/min, 14,400 req/day, ~16k input tokens/min -- the TPM cap binds
# first, empirically ~15 req/min sustained); gemini-*-flash models are only 20 req/day.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it

# NVIDIA NIM (used with `agent.run --provider nvidia`; key from build.nvidia.com,
# starts with nvapi-). No default model -- the study runs several; pass --model with
# one of: meta/llama-4-maverick-17b-128e-instruct, qwen/qwen3.5-397b-a17b,
# nvidia/llama-3.1-nemotron-nano-vl-8b-v1, mistralai/mistral-small-4-119b-2603
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Groq (used with `agent.run --provider groq`; key from console.groq.com). Free tier:
# 30 req/min but only 1,000 req/DAY -- full-set runs need --resume across days.
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# docker-compose.yml only (not read by the Python agent directly)
VLLM_PORT=8000
HF_TOKEN=  # only needed for gated/private Hugging Face models
