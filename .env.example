ANTHROPIC_API_KEY=  # only needed for agent/estimate_tokens.py's Claude-pricing estimate

# Classifier agent config -- points at a vLLM server (see docker-compose.yml),
# not Anthropic's API.
VLLM_BASE_URL=http://localhost:8000/v1  # or http://<gpu-host>:8000/v1 if vLLM runs elsewhere
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLLM_API_KEY=EMPTY  # vLLM ignores this unless an auth proxy requires it

# Gemini API (used with `agent.run --provider gemini`). Free tier of gemini-3.5-flash:
# 5 requests/min, 20 requests/day -- note one classification can spend several
# requests (tool-calling turns), so throttle with --rpm and expect a tiny daily budget.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# docker-compose.yml only (not read by the Python agent directly)
VLLM_PORT=8000
HF_TOKEN=  # only needed for gated/private Hugging Face models
